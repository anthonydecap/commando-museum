{
  "id": "link_list",
  "type": "SharedSlice",
  "name": "LinkList",
  "description": "Grouped list of partners, units or links",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": "Small label above the title"
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": ""
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "items": {
          "type": "Group",
          "config": {
            "label": "Items",
            "repeat": true,
            "fields": {
              "category": {
                "type": "Text",
                "config": {
                  "label": "Category",
                  "placeholder": ""
                }
              },
              "name": {
                "type": "Text",
                "config": {
                  "label": "Name",
                  "placeholder": ""
                }
              },
              "description": {
                "type": "Text",
                "config": {
                  "label": "Description",
                  "placeholder": ""
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link",
                  "allowText": true,
                  "allowTargetBlank": true,
                  "select": null
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}

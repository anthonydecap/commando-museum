{
  "id": "card_grid",
  "type": "SharedSlice",
  "name": "CardGrid",
  "description": "Grid of linked cards",
  "variations": [
    {
      "id": "default",
      "name": "Default",
      "docURL": "...",
      "version": "initial",
      "description": "Default",
      "imageUrl": "",
      "primary": {
        "eyebrow": {
          "type": "Text",
          "config": {
            "label": "Eyebrow",
            "placeholder": "Small label above the title"
          }
        },
        "title": {
          "type": "Text",
          "config": {
            "label": "Title",
            "placeholder": ""
          }
        },
        "intro": {
          "type": "StructuredText",
          "config": {
            "label": "Intro",
            "placeholder": "",
            "allowTargetBlank": true,
            "multi": "paragraph,strong,em,hyperlink"
          }
        },
        "tone": {
          "type": "Select",
          "config": {
            "label": "Tone",
            "options": ["light", "sand", "dark"],
            "default_value": "light"
          }
        },
        "cards": {
          "type": "Group",
          "config": {
            "label": "Cards",
            "repeat": true,
            "fields": {
              "image": {
                "type": "Image",
                "config": {
                  "label": "Image",
                  "constraint": {},
                  "thumbnails": []
                }
              },
              "kicker": {
                "type": "Text",
                "config": {
                  "label": "Kicker",
                  "placeholder": ""
                }
              },
              "title": {
                "type": "Text",
                "config": {
                  "label": "Title",
                  "placeholder": ""
                }
              },
              "body": {
                "type": "Text",
                "config": {
                  "label": "Body",
                  "placeholder": ""
                }
              },
              "link": {
                "type": "Link",
                "config": {
                  "label": "Link",
                  "allowText": true,
                  "allowTargetBlank": true,
                  "select": null
                }
              }
            }
          }
        }
      },
      "items": {}
    }
  ]
}

# Public URL of the site, used for canonical and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://www.museedescommandos.be

# Optional: point the site at another Prismic repository.
# NEXT_PUBLIC_PRISMIC_ENVIRONMENT=commando-museum

# Only needed for `npm run seed:prismic`. Never commit this value.
# PRISMIC_WRITE_TOKEN=
